<Window x:Class="XtremePlays.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XtremePlays.App"
        mc:Ignorable="d"
        Title="X-TREME PLAY'S" Width="1180" Height="760" MinWidth="920" MinHeight="600"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="6,0,6,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentGreenBrush}" Margin="0,0,11,0"><TextBlock Text="▶" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="X-TREME PLAY'S" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource MainTextBrush}" /><TextBlock Text="YOUR MUSIC. YOUR SPACE. YOUR PLAY." FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Padding="12,7" Background="#0D6BA889" CornerRadius="12" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Native shell ready" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LIBRARY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="10,8,0,8" />
                    <StackPanel>
                        <Button Tag="Home" Click="NavigationItem_Click" Background="{StaticResource PaleMintBrush}" AutomationProperties.Name="Open Home"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="17" Width="26" /><TextBlock Text="Home" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Tag="YouTube" Click="NavigationItem_Click" AutomationProperties.Name="Open YouTube"><StackPanel Orientation="Horizontal"><TextBlock Text="▶" FontSize="14" Width="26" /><TextBlock Text="YouTube" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Tag="YouTube Music" Click="NavigationItem_Click" AutomationProperties.Name="Open YouTube Music"><StackPanel Orientation="Horizontal"><TextBlock Text="♫" FontSize="17" Width="26" /><TextBlock Text="YouTube Music" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Tag="Spotify" Click="NavigationItem_Click" AutomationProperties.Name="Open Spotify"><StackPanel Orientation="Horizontal"><TextBlock Text="●" FontSize="15" Width="26" /><TextBlock Text="Spotify" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Tag="Bookmarks" Click="NavigationItem_Click" AutomationProperties.Name="Open Bookmarks"><StackPanel Orientation="Horizontal"><TextBlock Text="☆" FontSize="18" Width="26" /><TextBlock Text="Bookmarks" VerticalAlignment="Center" /></StackPanel></Button>
                        <Separator Margin="8,12" Background="#1A20332D" />
                        <Button Tag="Audio Sharing" Click="NavigationItem_Click" AutomationProperties.Name="Open Audio Sharing"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="16" Width="26" /><TextBlock Text="Audio Sharing" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Tag="Settings" Click="NavigationItem_Click" AutomationProperties.Name="Open Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="26" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Tag="About" Click="NavigationItem_Click" AutomationProperties.Name="Open About"><StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" FontSize="16" Width="26" /><TextBlock Text="About" VerticalAlignment="Center" /></StackPanel></Button>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="#0D669CB5" CornerRadius="12" Padding="10" Margin="0,14,0,0"><TextBlock Text="Browser integration arrives in the next phase." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" /></Border>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="32">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="WELCOME TO" Foreground="{StaticResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" /><TextBlock x:Name="PageTitle" Text="Your music, in one focused space." Foreground="{StaticResource MainTextBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="PageDescription" Text="The native X-TREME PLAY'S shell is ready. Connect your favorite music services in the next phase." Foreground="{StaticResource MutedTextBrush}" FontSize="14" LineHeight="22" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="570" /></StackPanel>
                    <Grid Grid.Row="1" Margin="0,28,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PaleMintBrush}" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="01" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" /><TextBlock Text="Music services" Foreground="{StaticResource MainTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,11,0,5" /><TextBlock Text="YouTube, YouTube Music, and Spotify will open safely inside the app." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="20" /></StackPanel></Border>
                        <Border Grid.Column="2" Background="#0D669CB5" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="02" Foreground="{StaticResource AccentBlueBrush}" FontWeight="Bold" /><TextBlock Text="Privacy first" Foreground="{StaticResource MainTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,11,0,5" /><TextBlock Text="No account or telemetry is required for the native application shell." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="20" /></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Background="#08000000" CornerRadius="12" Padding="14"><TextBlock x:Name="StatusText" Text="Phase 1 • WPF application shell" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /></Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="14,10" Margin="0,16,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource PaleMintBrush}" Margin="0,0,10,0"><TextBlock Text="♫" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Text="Player controls" Foreground="{StaticResource MainTextBrush}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Available when a supported service is connected" Foreground="{StaticResource MutedTextBrush}" FontSize="10" /></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button IsEnabled="False" AutomationProperties.Name="Previous track"><TextBlock Text="⏮" FontSize="16" /></Button><Button IsEnabled="False" AutomationProperties.Name="Play or pause"><TextBlock Text="▶" FontSize="16" /></Button><Button IsEnabled="False" AutomationProperties.Name="Next track"><TextBlock Text="⏭" FontSize="16" /></Button></StackPanel>
                <TextBlock Grid.Column="2" Text="No active source" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
