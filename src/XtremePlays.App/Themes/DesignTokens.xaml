<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#0B0B0F</Color>
    <Color x:Key="SurfaceColor">#111216</Color>
    <Color x:Key="AccentBlueColor">#06B6D4</Color>
    <Color x:Key="AccentGreenColor">#22C55E</Color>
    <Color x:Key="PaleMintColor">#17372C</Color>
    <Color x:Key="MainTextColor">#F5F5F7</Color>
    <Color x:Key="MutedTextColor">#A1A1AA</Color>
    <Color x:Key="SecondarySurfaceColor">#1A1B23</Color>
    <Color x:Key="SecondaryTextColor">#D4D4D8</Color>
    <Color x:Key="NavigationActiveColor">#322248</Color>
    <Color x:Key="SubtleBlueColor">#171B27</Color>
    <Color x:Key="SubtleBorderColor">#2A2D36</Color>
    <Color x:Key="AccentPurpleColor">#8B5CF6</Color>
    <Color x:Key="PurpleTintColor">#251A37</Color>
    <Color x:Key="AccentDangerColor">#EF4444</Color>
    <Color x:Key="AccentWarningColor">#F59E0B</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="PaleMintBrush" Color="{StaticResource PaleMintColor}" />
    <SolidColorBrush x:Key="MainTextBrush" Color="{StaticResource MainTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="NavigationActiveBrush" Color="{StaticResource NavigationActiveColor}" />
    <SolidColorBrush x:Key="SubtleBlueBrush" Color="{StaticResource SubtleBlueColor}" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="PurpleTintBrush" Color="{StaticResource PurpleTintColor}" />
    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDangerColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#248B5CF6" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#3D8B5CF6" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" /><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
