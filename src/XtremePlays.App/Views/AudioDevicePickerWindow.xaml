<Window x:Class="XtremePlays.App.Views.AudioDevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio devices · X-TREME PLAY'S"
        Width="760" Height="620" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,2,16">
            <TextBlock Text="QUICK AUDIO ROUTING" Foreground="{DynamicResource AccentPurpleBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Choose your devices" Foreground="{DynamicResource MainTextBrush}" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0" />
            <TextBlock Text="Selected microphones are mixed into Audio Sharing. The call output remains your VB-CABLE device." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="INPUT · MICROPHONES" Foreground="{DynamicResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" Margin="2,0,0,8" />
                    <ListBox x:Name="MicrophoneList" Grid.Row="1" ItemsSource="{Binding Microphones}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource SecondaryTextBrush}" Padding="5,7" Margin="1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="OUTPUT · LISTEN ON" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" Margin="2,0,0,8" />
                    <ListBox x:Name="OutputList" Grid.Row="1" ItemsSource="{Binding Outputs}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource SecondaryTextBrush}" Padding="5,7" Margin="1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SubtleBlueBrush}" CornerRadius="11" Padding="11" Margin="0,12,0,10">
            <TextBlock Text="You can select multiple devices. Multiple speakers may have a slight delay between them; headphones help prevent microphone echo. Leave output devices unchecked to send only to the call cable." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3">
            <TextBlock x:Name="SelectionStatus" Text="Choose at least one microphone. Listening outputs are optional." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                <Button Content="Save devices" Click="Save_Click" IsDefault="True" MinWidth="108" Background="{DynamicResource AccentPurpleBrush}" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
