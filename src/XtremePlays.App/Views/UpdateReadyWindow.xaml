<Window x:Class="XtremePlays.App.Views.UpdateReadyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X-TREME PLAY'S update"
        Width="500" Height="300" MinWidth="460" MinHeight="280"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource PurpleTintBrush}" Margin="0,0,12,0">
                <TextBlock Text="↑" Foreground="{DynamicResource AccentPurpleBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Update downloaded" Foreground="{DynamicResource MainTextBrush}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Text="Version 2.0.0 is ready" Foreground="{DynamicResource AccentCyanBrush}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,18,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Restart now to install the update." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                <TextBlock Text="Choose Install later to keep using this version. The downloaded update will install automatically the next time you open X-TREME PLAY'S." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Install later" Click="InstallLater_Click" IsCancel="True" MinWidth="106" Margin="0,0,8,0" />
            <Button Content="Install and restart" Click="InstallNow_Click" IsDefault="True" MinWidth="150" Background="{DynamicResource AccentPurpleBrush}" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
