<Window x:Class="XtremePlays.App.Views.PluginStoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X-TREME PLAY'S Plugins"
        Width="920" Height="650" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="X-TREME PLAY'S" Foreground="{DynamicResource AccentPurpleBrush}" FontWeight="Bold" FontSize="11" />
                <TextBlock Text="Plugins" Foreground="{DynamicResource MainTextBrush}" FontWeight="SemiBold" FontSize="28" Margin="0,3,0,0" />
                <TextBlock Text="Choose add-ons from the X-TREME GitHub catalog. Nothing installs until you choose it." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Click="Close_Click" VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="All" Content="All" Click="Category_Click" Background="{DynamicResource NavigationActiveBrush}" Margin="0,0,7,0" />
                    <Button Tag="Extensions" Content="🧩  Extensions" Click="Category_Click" Margin="0,0,7,0" />
                    <Button Tag="Ad blockers" Content="🛡  Ad blockers" Click="Category_Click" Margin="0,0,7,0" />
                    <Button Tag="Music" Content="♫  Music" Click="Category_Click" Margin="0,0,7,0" />
                    <Button Tag="Tools" Content="⚙  Tools" Click="Category_Click" />
                </StackPanel>
            </ScrollViewer>
            <TextBox x:Name="SearchBox" Grid.Column="1" Height="38" VerticalContentAlignment="Center" Padding="12,4"
                     ToolTip="Search the X-TREME plugin catalog" TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="10">
            <Grid>
                <ListBox x:Name="PluginList" ItemsSource="{Binding PluginCards}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                    BorderThickness="1" CornerRadius="13" Padding="14" Margin="2,2,2,9">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentPurpleBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Icon}" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Entry.Name}" Foreground="{DynamicResource MainTextBrush}" FontWeight="SemiBold" FontSize="15" />
                                            <Border Background="{DynamicResource PurpleTintBrush}" CornerRadius="7" Padding="7,2" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding Entry.SourceLabel}" Foreground="{DynamicResource AccentPurpleBrush}" FontWeight="SemiBold" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Entry.Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,5" />
                                        <WrapPanel>
                                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{DynamicResource AccentCyanBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Entry.Publisher}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Entry.License}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        </WrapPanel>
                                        <ItemsControl ItemsSource="{Binding Entry.Capabilities}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="{Binding PrimaryActionText}" Tag="{Binding}" Click="PrimaryAction_Click"
                                                IsEnabled="{Binding CanPrimaryAction}" Background="{DynamicResource AccentPurpleBrush}"
                                                Foreground="White" HorizontalContentAlignment="Center" MinWidth="100" />
                                        <Button Content="{Binding ToggleActionText}" Tag="{Binding}" Click="ToggleExtension_Click"
                                                Visibility="{Binding ToggleVisibility}" HorizontalContentAlignment="Center" MinWidth="100" Margin="0,7,0,0" />
                                        <Button Content="{Binding PinActionText}" Tag="{Binding}" Click="PinExtension_Click"
                                                Visibility="{Binding PinVisibility}" HorizontalContentAlignment="Center" MinWidth="100" Margin="0,7,0,0" />
                                        <Button Content="Source" Tag="{Binding}" Click="OpenSource_Click" HorizontalContentAlignment="Center" MinWidth="100" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyStateTitle" Text="No plugins in this category" Foreground="{DynamicResource MainTextBrush}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateMessage" Text="New plugins published to the X-TREME catalog will appear here." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="4,12,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="PluginStatusText" Text="Loading the X-TREME GitHub catalog…" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Refresh catalog" Click="RefreshCatalog_Click" Background="{DynamicResource SecondarySurfaceBrush}" />
        </Grid>
    </Grid>
</Window>
