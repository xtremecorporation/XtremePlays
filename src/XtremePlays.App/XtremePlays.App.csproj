<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>XtremePlays</AssemblyName>
    <RootNamespace>XtremePlays.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>embedded</DebugType>
    <Version>1.4.0</Version>
    <ApplicationIcon>Assets\XtremePlays.ico</ApplicationIcon>
    <StartupObject>XtremePlays.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BrandLogo.png" />
    <Resource Include="Assets\DeveloperAvatar.jpg" />
    <Resource Include="Assets\XtremePlays.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\native\xtreme_adblock_bridge\target\x86_64-pc-windows-msvc\release\xtreme_adblock_bridge.dll"
             Condition="Exists('..\..\native\xtreme_adblock_bridge\target\x86_64-pc-windows-msvc\release\xtreme_adblock_bridge.dll')">
      <Link>xtreme_adblock_bridge.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
