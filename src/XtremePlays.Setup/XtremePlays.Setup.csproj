<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XtremePlaysSetup</AssemblyName>
    <RootNamespace>XtremePlays.Setup</RootNamespace>
    <Version>1.3.2</Version>
    <ApplicationIcon>..\XtremePlays.App\Assets\XtremePlays.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AppSetupPath Condition="'$(AppSetupPath)' == ''">..\..\artifacts\velopack\XtremePlays-win-Setup.exe</AppSetupPath>
    <DriverPackagePath Condition="'$(DriverPackagePath)' == ''">..\..\packaging\third-party\VBCABLE_Driver_Pack45.zip</DriverPackagePath>
    <NoticePath Condition="'$(NoticePath)' == ''">..\..\packaging\third-party\VB-CABLE-NOTICE.txt</NoticePath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(AppSetupPath)" LogicalName="VelopackSetup.exe" />
    <EmbeddedResource Include="$(DriverPackagePath)" LogicalName="VBCABLE_Driver_Pack45.zip" />
    <EmbeddedResource Include="$(NoticePath)" LogicalName="VB-CABLE-NOTICE.txt" />
  </ItemGroup>
</Project>
